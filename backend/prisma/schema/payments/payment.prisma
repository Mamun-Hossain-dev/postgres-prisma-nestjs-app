enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_PROCESSING
  PAID
  COD_CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  PAYMENT_FAILED
  CANCELLED
}

enum CheckoutPaymentMethod {
  CARD
  CASH_ON_DELIVERY
}

enum DeliveryZone {
  DHAKA
  OUTSIDE_DHAKA
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ConsumerEventStatus {
  PROCESSING
  PROCESSED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponRedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

model Order {
  id                  Int                   @id @default(autoincrement())
  orderNumber         String                @unique
  userId              Int
  user                User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerName        String
  customerEmail       String
  customerPhone       String
  deliveryAddressLine String
  deliveryArea        String
  deliveryCity        String
  deliveryPostalCode  String?
  couponId            Int?
  coupon              Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode          String?
  paymentMethod       CheckoutPaymentMethod @default(CARD)
  deliveryZone        DeliveryZone          @default(DHAKA)
  subtotalAmount      Int
  discountAmount      Int                   @default(0)
  deliveryCharge      Int
  totalAmount         Int
  currency            String
  status              OrderStatus           @default(PAYMENT_PENDING)
  items               OrderItem[]
  payments            Payment[]
  couponRedemption    CouponRedemption?
  paidAt              DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([couponId])
  @@map("orders")
}

model Coupon {
  id            Int                @id @default(autoincrement())
  code          String             @unique
  description   String?
  type          CouponType
  value         Int
  minimumAmount Int                @default(0)
  usageLimit    Int?
  remainingUses Int?
  usedCount     Int                @default(0)
  isActive      Boolean            @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  orders        Order[]
  redemptions   CouponRedemption[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id        Int                    @id @default(autoincrement())
  couponId  Int
  coupon    Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId    Int
  user      User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId   Int                    @unique
  order     Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    CouponRedemptionStatus @default(RESERVED)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([couponId, status])
  @@map("coupon_redemptions")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  productSku   String
  unitAmount   Int
  quantity     Int
  totalAmount  Int
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id               Int             @id @default(autoincrement())
  orderId          Int
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider         PaymentProvider @default(STRIPE)
  status           PaymentStatus   @default(PENDING)
  amount           Int
  currency         String
  idempotencyKey   String          @unique
  providerIntentId String?         @unique
  failureCode      String?
  failureMessage   String?
  paidAt           DateTime?
  refundedAt       DateTime?
  refunds          Refund[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId, createdAt])
  @@index([status])
  @@map("payments")
}

model Refund {
  id               Int             @id @default(autoincrement())
  paymentId        Int
  payment          Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  provider         PaymentProvider @default(STRIPE)
  providerRefundId String?         @unique
  amount           Int
  currency         String
  reason           String?
  status           RefundStatus    @default(PENDING)
  failureCode      String?
  failureMessage   String?
  requestedById    Int?
  requestedBy      User?           @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  idempotencyKey   String          @unique
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([paymentId, status])
  @@index([requestedById])
  @@map("refunds")
}

model PaymentWebhookEvent {
  id          Int      @id @default(autoincrement())
  provider    String
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([provider, eventType])
  @@map("payment_webhook_events")
}

model ProcessedConsumerEvent {
  id          Int                 @id @default(autoincrement())
  consumer    String
  eventId     String
  status      ConsumerEventStatus @default(PROCESSING)
  processedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([consumer, eventId])
  @@index([status, updatedAt])
  @@map("processed_consumer_events")
}
