enum ProductCategory {
  MOBILE
  LAPTOP
  TABLET
  AUDIO
  WATCH
  ACCESSORY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               Int             @id @default(autoincrement())
  slug             String          @unique
  sku              String          @unique
  title            String
  shortDescription String?
  description      String
  brand            String
  category         ProductCategory
  price            Float
  compareAtPrice   Float?
  quantity         Int
  status           ProductStatus   @default(ACTIVE)
  isFeatured       Boolean         @default(false)
  isTrending       Boolean         @default(false)
  isBestSeller     Boolean         @default(false)
  offerStartsAt    DateTime?
  offerEndsAt      DateTime?
  publishedAt      DateTime        @default(now())
  specifications   Json?
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  stockMovements   StockMovement[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([category])
  @@index([brand])
  @@index([isFeatured])
  @@index([status, publishedAt])
  @@index([status, category, createdAt])
  @@index([isTrending])
  @@index([isBestSeller])
  @@map("products")
}

model StockMovement {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustedById  Int
  adjustedBy    User     @relation(fields: [adjustedById], references: [id], onDelete: Restrict)
  previousStock Int
  newStock      Int
  change        Int
  reason        String
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
  @@index([adjustedById])
  @@map("stock_movements")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String   @unique
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}
