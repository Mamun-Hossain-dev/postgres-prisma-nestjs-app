# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
Global_API_PREFIX=api/v1/
CORS_ORIGIN=http://localhost:3000

# Neon serverless PostgreSQL. Paste your Neon connection string (Project -> Connect,
# unpooled/direct connection) and append ?sslmode=require. Example:
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-xxxx.region.aws.neon.tech/devicedock?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_KOp4XC8nkPcr@ep-sparkling-bar-azmx8ac3-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=devicedock
RABBITMQ_PASSWORD=devicedock_121869
RABBITMQ_URL=amqp://devicedock:devicedock_121869@localhost:5672
RABBITMQ_PREFETCH_COUNT=10

# Authentication
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=refresh_token

# Cloudinary dummy values; replace before using uploads
CLOUDINARY_CLOUD_NAME=dummy_cloud_name
CLOUDINARY_API_KEY=dummy_cloudinary_api_key
CLOUDINARY_API_SECRET=dummy_cloudinary_api_secret
CLOUDINARY_FOLDER=devicedock
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_PRODUCT_IMAGES=10

# Local email testing with the Mailpit Compose service
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DeviceDock <no-reply@devicedock.local>

# Stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt
STRIPE_MINOR_UNIT=100
PAYMENT_LOCK_TTL_SECONDS=30
