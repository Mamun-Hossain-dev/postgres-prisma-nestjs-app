# Application
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
Global_API_PREFIX=api/v1/
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Compose constructs DATABASE_URL from these values)
POSTGRES_USER=devicedock
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=devicedock
DATABASE_URL=postgresql://devicedock:replace_with_a_strong_database_password@localhost:5432/devicedock?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=devicedock
RABBITMQ_PASSWORD=replace_with_a_strong_rabbitmq_password
RABBITMQ_URL=amqp://devicedock:replace_with_a_strong_rabbitmq_password@localhost:5672
RABBITMQ_PREFETCH_COUNT=10

# Authentication
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=refresh_token

# Cloudinary dummy values; replace before using uploads
CLOUDINARY_CLOUD_NAME=dummy_cloud_name
CLOUDINARY_API_KEY=dummy_cloudinary_api_key
CLOUDINARY_API_SECRET=dummy_cloudinary_api_secret
CLOUDINARY_FOLDER=devicedock
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_PRODUCT_IMAGES=10

# Email is safe to leave disabled with dummy SMTP values
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dummy_smtp_user
SMTP_PASSWORD=dummy_smtp_password
MAIL_FROM=no-reply@example.com
