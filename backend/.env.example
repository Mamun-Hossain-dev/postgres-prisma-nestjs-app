# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
Global_API_PREFIX=api/v1/
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/devicedock?sslmode=require

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://devicedock:replace_with_a_local_password@localhost:5672
RABBITMQ_PREFETCH_COUNT=10

# Authentication
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=refresh_token
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=devicedock
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_MAX_PRODUCT_IMAGES=10

# Local email testing with Mailpit
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="DeviceDock <no-reply@devicedock.local>"

# Stripe
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_CURRENCY=usd
STRIPE_MINOR_UNIT=100
PAYMENT_LOCK_TTL_SECONDS=30
