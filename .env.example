# Docker Compose orchestration values.
# Copy this file to .env at the repository root.
RABBITMQ_USER=devicedock
RABBITMQ_PASSWORD=replace_with_a_local_password

BACKEND_NODE_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
CORS_ORIGIN=http://localhost:3000
REDIS_HOST=redis
REDIS_PORT=6379
MAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false

FRONTEND_NODE_ENV=production
FRONTEND_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_long_random_secret
API_INTERNAL_URL=http://backend:8080/api/v1
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
