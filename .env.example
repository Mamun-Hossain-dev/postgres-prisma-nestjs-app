# Docker Compose orchestration values.
# Copy this file to .env at the repository root; `docker compose` loads it
# automatically for ${VAR} interpolation in compose.yaml.
# Run compose from the repository root so this .env is picked up.
# Never commit the real .env (it is gitignored).

# RabbitMQ credentials (shared by the rabbitmq service and the backend's
# RABBITMQ_URL). Change these before any non-local deployment.
RABBITMQ_USER=devicedock
RABBITMQ_PASSWORD=

# Backend runtime overrides. compose overrides backend/.env so the app talks
# to the in-network services instead of localhost.
BACKEND_NODE_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
CORS_ORIGIN=http://localhost:3000
REDIS_HOST=redis
REDIS_PORT=6379
MAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false

# Frontend runtime (server-side, read at runtime).
FRONTEND_NODE_ENV=production
FRONTEND_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
API_INTERNAL_URL=http://backend:8080/api/v1

# Frontend build-time values (inlined into the browser bundle).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
