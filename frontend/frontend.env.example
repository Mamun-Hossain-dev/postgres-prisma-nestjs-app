# Frontend runtime configuration for /opt/devicedock/frontend/frontend.env
# NEXT_PUBLIC_* values are intentionally absent: they are baked into the image.

NEXTAUTH_URL=https://devicedock.duckdns.org
NEXTAUTH_SECRET=replace_with_a_random_32_byte_hex_secret
API_INTERNAL_URL=http://backend:8080/api/v1
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
